# Copy this file to ".env" and edit it.
# --- MySQL (XAMPP default: user root, empty password) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ayurlex
SECRET_KEY=change-this-to-any-random-text

# --- AI answers (optional). No key = the app still works and quotes the best source passages. ---
# Get a free Gemini key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# or: LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Tuning (leave as is) ---
MIN_CONFIDENCE=0.20
